      <widget class="QWidget" name="auto_tab">
       <attribute name="title">
        <string>Automate</string>
       </attribute>
       <layout class="QHBoxLayout" name="auto_main_layout">
        <property name="spacing">
         <number>4</number>
        </property>
        <property name="leftMargin">
         <number>4</number>
        </property>
        <property name="topMargin">
         <number>4</number>
        </property>
        <property name="rightMargin">
         <number>4</number>
        </property>
        <property name="bottomMargin">
         <number>4</number>
        </property>
        <item>
         <widget class="QSplitter" name="auto_splitter">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <widget class="QScrollArea" name="auto_controls_scroll">
           <property name="widgetResizable">
            <bool>true</bool>
           </property>
           <property name="frameShape">
            <enum>QFrame::NoFrame</enum>
           </property>
           <widget class="QWidget" name="auto_controls_content">
            <layout class="QVBoxLayout" name="auto_controls_layout">
             <property name="spacing">
              <number>8</number>
             </property>
             <property name="leftMargin">
              <number>4</number>
             </property>
             <property name="topMargin">
              <number>4</number>
             </property>
             <property name="rightMargin">
              <number>6</number>
             </property>
             <property name="bottomMargin">
              <number>4</number>
             </property>
             <item>
              <widget class="QLabel" name="lbl_auto_title">
               <property name="font">
                <font>
                 <pointsize>11</pointsize>
                 <weight>75</weight>
                 <bold>true</bold>
                </font>
               </property>
               <property name="text">
                <string>Varredura Automatizada de Parâmetros</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_auto_desc">
               <property name="wordWrap">
                <bool>true</bool>
               </property>
               <property name="text">
                <string>Defina cada um dos 7 parâmetros como fixo ou variável (varredura com início, fim e passo). O sistema calculará todas as combinações e executará em lote.</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="grp_auto_params">
               <property name="title">
                <string>1. Configuração dos 7 Parâmetros Quânticos</string>
               </property>
               <layout class="QVBoxLayout" name="auto_params_layout">
                <property name="spacing">
                 <number>6</number>
                </property>
                <!-- Parameter 0: LLQW -->
                <item>
                 <widget class="QFrame" name="auto_frame_0">
                  <property name="frameShape">
                   <enum>QFrame::StyledPanel</enum>
                  </property>
                  <layout class="QGridLayout" name="auto_grid_0">
                   <item row="0" column="0" colspan="2">
                    <widget class="QLabel" name="auto_lbl_0">
                     <property name="font">
                      <font><weight>75</weight><bold>true</bold></font>
                     </property>
                     <property name="text">
                      <string>s0: LLQW (Nº Poços Esquerdos)</string>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="2">
                    <widget class="QComboBox" name="auto_mode_0_cbox">
                     <item><property name="text"><string>Fixo</string></property></item>
                     <item><property name="text"><string>Varredura</string></property></item>
                    </widget>
                   </item>
                   <item row="1" column="0">
                    <widget class="QLabel" name="auto_fix_lbl_0"><property name="text"><string>Valor Fixo:</string></property></widget>
                   </item>
                   <item row="1" column="1">
                    <widget class="QSpinBox" name="auto_fixed_0_spb">
                     <property name="minimum"><number>0</number></property>
                     <property name="maximum"><number>50</number></property>
                     <property name="value"><number>5</number></property>
                    </widget>
                   </item>
                   <item row="2" column="0">
                    <widget class="QLabel" name="auto_swp_lbl_0"><property name="text"><string>Início / Fim / Passo:</string></property></widget>
                   </item>
                   <item row="2" column="1">
                    <layout class="QHBoxLayout" name="auto_swp_box_0">
                     <item><widget class="QSpinBox" name="auto_start_0_spb"><property name="minimum"><number>0</number></property><property name="maximum"><number>50</number></property><property name="value"><number>1</number></property></widget></item>
                     <item><widget class="QSpinBox" name="auto_end_0_spb"><property name="minimum"><number>0</number></property><property name="maximum"><number>50</number></property><property name="value"><number>5</number></property></widget></item>
                     <item><widget class="QSpinBox" name="auto_step_0_spb"><property name="minimum"><number>1</number></property><property name="maximum"><number>20</number></property><property name="value"><number>1</number></property></widget></item>
                     <item><widget class="QLabel" name="auto_pts_0_lbl"><property name="text"><string>(1 pts)</string></property></widget></item>
                    </layout>
                   </item>
                  </layout>
                 </widget>
                </item>
                <!-- Parameter 1: LQW -->
                <item>
                 <widget class="QFrame" name="auto_frame_1">
                  <property name="frameShape">
                   <enum>QFrame::StyledPanel</enum>
                  </property>
                  <layout class="QGridLayout" name="auto_grid_1">
                   <item row="0" column="0" colspan="2">
                    <widget class="QLabel" name="auto_lbl_1">
                     <property name="font">
                      <font><weight>75</weight><bold>true</bold></font>
                     </property>
                     <property name="text">
                      <string>s1: LQW (Poço Esquerdo [nm])</string>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="2">
                    <widget class="QComboBox" name="auto_mode_1_cbox">
                     <item><property name="text"><string>Fixo</string></property></item>
                     <item><property name="text"><string>Varredura</string></property></item>
                    </widget>
                   </item>
                   <item row="1" column="0">
                    <widget class="QLabel" name="auto_fix_lbl_1"><property name="text"><string>Valor Fixo:</string></property></widget>
                   </item>
                   <item row="1" column="1">
                    <widget class="QDoubleSpinBox" name="auto_fixed_1_spb">
                     <property name="decimals"><number>2</number></property>
                     <property name="minimum"><double>0.5</double></property>
                     <property name="maximum"><double>50.0</double></property>
                     <property name="singleStep"><double>0.1</double></property>
                     <property name="value"><double>6.3</double></property>
                     <property name="suffix"><string> nm</string></property>
                    </widget>
                   </item>
                   <item row="2" column="0">
                    <widget class="QLabel" name="auto_swp_lbl_1"><property name="text"><string>Início / Fim / Passo:</string></property></widget>
                   </item>
